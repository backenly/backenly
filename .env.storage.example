# =============================================================================
# STORAGE CONFIGURATION
# =============================================================================

# Storage Driver: 'local' or 's3'
# - local: Files stored on server disk (good for development)
# - s3: Files stored in S3-compatible object storage (REQUIRED for production)
STORAGE_DRIVER=local

# Local Storage Configuration (when STORAGE_DRIVER=local)
STORAGE_DIR=./storage

# =============================================================================
# S3-COMPATIBLE STORAGE CONFIGURATION (when STORAGE_DRIVER=s3)
# =============================================================================

# S3 Endpoint URL
# - AWS S3: https://s3.amazonaws.com or https://s3.{region}.amazonaws.com
# - Cloudflare R2: https://{account-id}.r2.cloudflarestorage.com
# - MinIO: http://localhost:9000 or https://your-minio-server.com
# - Backblaze B2: https://s3.{region}.backblazeb2.com
STORAGE_S3_ENDPOINT=

# S3 Region
# - AWS: us-east-1, us-west-2, eu-west-1, etc.
# - Cloudflare R2: auto
# - MinIO: auto or us-east-1
STORAGE_S3_REGION=auto

# S3 Bucket Name
# All files across all projects go into this bucket with projectId/bucketId prefixes
STORAGE_S3_BUCKET=

# S3 Access Credentials
STORAGE_S3_ACCESS_KEY=
STORAGE_S3_SECRET_KEY=

# Optional: Public CDN URL for public files
# If set, public files will use this URL instead of presigned URLs
# Example: https://cdn.yourdomain.com or https://pub-xxxxx.r2.dev
STORAGE_S3_PUBLIC_URL=

# =============================================================================
# EXAMPLE CONFIGURATIONS
# =============================================================================

# AWS S3 Example:
# STORAGE_DRIVER=s3
# STORAGE_S3_ENDPOINT=https://s3.us-east-1.amazonaws.com
# STORAGE_S3_REGION=us-east-1
# STORAGE_S3_BUCKET=nexabackend-storage
# STORAGE_S3_ACCESS_KEY=AKIAIOSFODNN7EXAMPLE
# STORAGE_S3_SECRET_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY

# Cloudflare R2 Example:
# STORAGE_DRIVER=s3
# STORAGE_S3_ENDPOINT=https://abc123.r2.cloudflarestorage.com
# STORAGE_S3_REGION=auto
# STORAGE_S3_BUCKET=nexabackend-storage
# STORAGE_S3_ACCESS_KEY=your_r2_access_key
# STORAGE_S3_SECRET_KEY=your_r2_secret_key
# STORAGE_S3_PUBLIC_URL=https://pub-abc123.r2.dev

# MinIO (Self-hosted) Example:
# STORAGE_DRIVER=s3
# STORAGE_S3_ENDPOINT=http://localhost:9000
# STORAGE_S3_REGION=us-east-1
# STORAGE_S3_BUCKET=nexabackend-storage
# STORAGE_S3_ACCESS_KEY=minioadmin
# STORAGE_S3_SECRET_KEY=minioadmin
