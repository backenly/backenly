# =============================================================================
# BACKENLY ENVIRONMENT CONFIGURATION
# =============================================================================
# Copy this file to .env and fill in your actual values

# =============================================================================
# EDITION
# =============================================================================
# Which Backenly this deployment is. Omitting it is safe: an unset edition
# resolves to single-tenant, so a fresh clone is a self-hosted, one-project
# install with no configuration at all.
#
# It is set explicitly here anyway, because the deploy and composition scripts
# deliberately REFUSE to guess. scripts/compose-cloud.sh reads this file when
# the variable is absent from the environment and stops if it finds nothing:
# defaulting to cloud would make a self-host deploy try to clone a private
# repository it cannot read, and defaulting to single-tenant would let a Cloud
# deploy build with no control plane. Copying this template therefore gives you
# a deployment that works without having to discover that rule later.
#
#   single-tenant   self-hosted Backenly. One deployment is one project.
#   cloud           Backenly Cloud. REQUIRES the private overlay from
#                   backenly/backenly-cloud; a cloud process that cannot find
#                   it exits at startup rather than falling back.
#
# Anything else is refused rather than guessed at.
BACKENLY_EDITION=single-tenant

# =============================================================================
# DATABASE
# =============================================================================
# The credential the RUNNING application uses. It must NOT be a superuser.
#
# `npm run selfhost` creates `backenly_app` (NOSUPERUSER NOBYPASSRLS) and
# rewrites these two lines to name it. The value below is only the starting
# point the installer reads before that role exists.
#
# Why it matters: a superuser bypasses row-level security, including FORCE ROW
# LEVEL SECURITY. Run the application as one and every policy the platform
# writes is advisory for the application itself - isolation then rests on the
# code remembering to scope each query rather than on the database refusing.
#
# The role still OWNS the platform tables and the workspace schemas, because
# PostgreSQL ties ALTER and DROP to ownership and the governed typed actions
# need them. FORCE RLS is what keeps that safe: without it an owner is exempt
# from its own policies.
DATABASE_URL=postgresql://backenly_user:changeme@localhost:5432/backenly
DIRECT_URL=postgresql://backenly_user:changeme@localhost:5432/backenly

# The elevated credential, used ONLY while installing.
#
# Creating roles, installing event triggers and setting database-level settings
# all require a superuser. Those run once, from scripts. Recording the
# connection here keeps them possible without the running application holding
# that power - which is the whole point of the split.
#
# `npm run selfhost` fills this in on its first run, from whatever DATABASE_URL
# pointed at before the application role existed. Never used by the web or
# runtime processes.
BACKENLY_ADMIN_DATABASE_URL=

# The connection pg_dump uses for workspace backups. Leave unset ONLY if the
# role in DATABASE_URL can bypass row-level security.
#
# Workspace tables are created FORCE ROW LEVEL SECURITY, and under FORCE even
# the table owner is subject to its policies. A pg_dump running as a role that
# cannot bypass RLS aborts on the first protected table:
#
#   pg_dump: error: query failed: ERROR: query would be affected by
#            row-level security policy for table "users"
#
# On production that meant every nightly backup failed for four days while the
# pruner deleted the last good ones, ending at zero backups on disk. It is
# It used to be invisible on the Compose stack, because the application ran as
# POSTGRES_USER - the bootstrap superuser - and superusers bypass RLS. Since
# the credential split it is not: `backenly_app` is NOSUPERUSER NOBYPASSRLS
# there too, so the Compose path now reproduces what managed Postgres does.
#
# Do NOT solve this by granting BYPASSRLS to the application role: that
# disables every RLS policy on every tenant at once. Create a dedicated role.
# The full privilege set it needs, and nothing more:
#
#   CREATE ROLE backenly_backup LOGIN PASSWORD '<secret>'
#     NOSUPERUSER NOCREATEDB NOCREATEROLE BYPASSRLS;
#   GRANT CONNECT ON DATABASE backenly TO backenly_backup;
#   GRANT USAGE ON SCHEMA "workspace_<project-id>" TO backenly_backup;
#   GRANT SELECT ON ALL TABLES IN SCHEMA "workspace_<project-id>" TO backenly_backup;
#
# It needs no CREATE and no membership of the application role: restore writes
# back over DATABASE_URL, so the application keeps ownership of its own schema.
# Proven by __tests__/services/backup-restore-privileges.test.ts.
# `npm run selfhost` creates this role and fills this in. It is here for a
# deployment that was installed before the installer did so, or one whose
# credential was lost: `npx tsx scripts/setup-backup-role.ts --apply` converges
# the role and prints the connection string.
# BACKUP_DATABASE_URL=postgresql://backenly_backup:changeme@localhost:5432/backenly

# The database the test suite runs against. Required, not optional:
# jest.setup.js exits rather than start without it, so that a test run can
# never point at the database you are developing against. `npm test` pushes
# the schema with --accept-data-loss, so this MUST NOT equal DATABASE_URL.
# docker-compose.dev.yml creates this database alongside the dev one.
TEST_DATABASE_URL=postgresql://backenly_user:changeme@localhost:5432/backenly_test

# MongoDB (Optional - if using MongoDB features)
MONGODB_URI=mongodb://localhost:27017/backenly

# =============================================================================
# AUTHENTICATION
# =============================================================================
# JWT Secret - MUST BE A STRONG RANDOM STRING IN PRODUCTION
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# Encrypts every per-project signing secret and every stored database
# credential at rest. Exactly 64 hex characters (32 bytes):
#
#   openssl rand -hex 32
#
# REQUIRED when NODE_ENV=production - the process refuses to start without it.
# Outside production an unset value silently falls back to a key of 32 zero
# bytes and says so only in a log line, which means a self-hosted install run
# with `npm run dev` encrypts its secrets with a key that is public knowledge.
# `npm run selfhost` generates a real one; set it yourself if you install by
# hand.
#
# Treat it like the database itself: if you lose it, every project signing
# secret and stored credential encrypted under it is unrecoverable. Changing it
# later needs scripts/migrate-master-key.ts, not an edit here.
MASTER_ENCRYPTION_KEY=

# Claims this self-hosted deployment. `npm run selfhost` generates it and
# prints it; the first account to present it at signup becomes the
# administrator AND takes ownership of the single project, in one transaction.
#
# Why a token rather than "whoever signs up first": a deployment is often
# reachable before its operator gets to it - an open port on a VPS, a preview
# environment, a colleague pointed at the wrong host. Any of those could take
# the single administrator slot, and the real operator would have no way back
# short of editing rows by hand. Possession of the machine grants the claim.
#
# Single-use in effect rather than by deletion: the account slot can only be
# taken once, so once this deployment is claimed the token is refused whatever
# it is set to. Leaving it in this file afterwards is harmless.
#
# Left empty on an install that predates this, which keeps working unchanged
# rather than locking its operator out on upgrade.
BACKENLY_SETUP_TOKEN=

# How many web/runtime instances this deployment runs. Default 1.
#
# The auth rate limiter keeps its counters IN MEMORY, per process. On one
# instance that is a real control; on several it is not - an attacker reaching
# N instances gets N budgets, so the effective limit on /api/auth/login and
# /api/v1/{projectId}/auth/* becomes N times what it reads.
#
# Raising a replica count is a capacity decision, and nobody would think to
# security-review it, so the deployment has to say the number out loud. Setting
# this above 1 without a shared store makes the server refuse to start.
BACKENLY_APP_INSTANCES=1

# Where the auth rate limiter keeps its counters: 'memory' (default) or
# 'redis'. Redis additionally requires REDIS_URL.
#
# SELF-HOST DOES NOT NEED THIS. A self-hosted deployment is single-tenant and
# runs one web process, so per-process counters are the correct answer and the
# default is unchanged. Redis is not part of the self-host stack and adding one
# buys nothing here.
#
# Set it to 'redis' only when running more than one instance, and set
# BACKENLY_APP_INSTANCES to match. Both counters then live in one place, so N
# instances enforce one budget instead of N.
#
# Startup PROVES the store rather than trusting the setting: it connects,
# pings, and writes a probe key. A REDIS_URL with a typo, behind a firewall, or
# pointed at a read-only replica fails the boot rather than the first sign-in.
#
# When the store is 'redis' and Redis cannot be reached, the limiter DENIES.
# It does not fall back to per-process counters. A deployment only reaches that
# code having declared several instances, so the fallback would hand out
# (limit x instances) at exactly the moment the store is most likely to be
# struggling because an attack is underway. The cost is real and worth knowing:
# a Redis outage takes sign-in down. It is loud, it is logged, and it is
# recoverable in minutes, none of which is true of a silent brute-force window.
BACKENLY_RATE_LIMIT_STORE=memory

# =============================================================================
# OPENAI API (REQUIRED FOR AI-POWERED BACKEND GENERATION)
# =============================================================================
# Get your key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini

# =============================================================================
# APPLICATION
# =============================================================================
NODE_ENV=development
PORT=3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# =============================================================================
# STORAGE (Optional feature - but STORAGE_SECRET is required to use it)
# =============================================================================
# Storage Driver: 'local' or 's3'
STORAGE_DRIVER=local
STORAGE_DIR=./storage

# Signs the access tokens that authorise reads of stored files. REQUIRED for
# uploads to work at all — without it every upload fails with a 500 and the
# reason is only visible in the server log:
#
#   STORAGE_SECRET is not set - refusing to sign a storage access token.
#
# There is deliberately no default. A hardcoded fallback in a public repository
# would mean signing and verifying with a publicly known key, which is an
# authentication bypass. Generate one per deployment:
#
#   openssl rand -hex 32
STORAGE_SECRET=your-storage-secret-change-this-in-production

# S3 Configuration (if STORAGE_DRIVER=s3)
# STORAGE_S3_ENDPOINT=https://s3.amazonaws.com
# STORAGE_S3_REGION=us-east-1
# STORAGE_S3_BUCKET=backenly-storage
# STORAGE_S3_ACCESS_KEY=your-access-key
# STORAGE_S3_SECRET_KEY=your-secret-key
# STORAGE_S3_PUBLIC_URL=https://cdn.yourdomain.com

# =============================================================================
# EMAIL (account codes and notifications)
# =============================================================================
# Needed for password-reset codes and, when BACKENLY_ALLOW_PUBLIC_SIGNUP=true,
# for the code a new account must enter before it exists. The first account
# (the operator claiming this install) never needs it.
#
# Without it, the reset page says email is unavailable, and a password can be
# reset on the server with: npm run auth:reset-password -- --email you@example.com
#
# Any SMTP provider works (Resend, SES, Mailgun, SendGrid, Gmail). Use port
# 587 (STARTTLS); a 465 is rewritten to 587 unless SMTP_ALLOW_IMPLICIT_TLS=true.
# SMTP_FROM must be an address on a domain your provider has verified.
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=587
# SMTP_USER=resend
# SMTP_PASS=your-smtp-password-or-api-key
# SMTP_FROM=Backenly <noreply@yourdomain.com>

# =============================================================================
# OAUTH PROVIDERS (Optional)
# =============================================================================
# Google OAuth
# GOOGLE_CLIENT_ID=your-google-client-id
# GOOGLE_CLIENT_SECRET=your-google-client-secret
# GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# GitHub OAuth
# GITHUB_CLIENT_ID=your-github-client-id
# GITHUB_CLIENT_SECRET=your-github-client-secret
# GITHUB_REDIRECT_URI=http://localhost:3000/auth/github/callback

# Replit OAuth (for one-click Replit connection)
# Get credentials from: https://replit.com/account/oauth-applications
# REPLIT_CLIENT_ID=your-replit-client-id
# REPLIT_CLIENT_SECRET=your-replit-client-secret

# =============================================================================
# REDIS (Optional - for caching and rate limiting)
# =============================================================================
# REDIS_URL=redis://localhost:6379

# =============================================================================
# SECURITY
# =============================================================================
# AI Execution Token (Internal - auto-generated if not set)
# AI_EXECUTION_TOKEN=your-secure-random-token

# Bypass AI enforcement (for testing/migration only)
# BYPASS_AI_ENFORCEMENT=false

# =============================================================================
# MONITORING (Optional)
# =============================================================================
# Sentry for error tracking
# SENTRY_DSN=your-sentry-dsn

# Disable quota enforcement (development only - DO NOT USE IN PRODUCTION)
# DISABLE_QUOTA_ENFORCEMENT=true

# Cron secret for automated jobs (generate a secure random string)
CRON_SECRET=your-secure-cron-secret-here

# =============================================================================
# DEPLOYMENT (Production only)
# =============================================================================
# Vercel
# VERCEL_URL=your-app.vercel.app

# Docker
# DOCKER_REGISTRY=docker.io
# DOCKER_REPOSITORY=backenly

# =============================================================================
# QUICK START GUIDE
# =============================================================================
# 
# 1. Copy this file: cp .env.example .env
# 
# 2. REQUIRED: Set these variables:
#    - DATABASE_URL (PostgreSQL connection string)
#    - JWT_SECRET (generate a strong random string)
#    - OPENAI_API_KEY (get from OpenAI platform)
#    - PADDLE_VENDOR_ID (get from Paddle dashboard)
#    - PADDLE_API_KEY (get from Paddle dashboard)
#    - PADDLE_PUBLIC_KEY (get from Paddle dashboard)
#    - PADDLE_WEBHOOK_SECRET (configure webhook endpoint)
#    - PADDLE_PLAN_ID_PRO (create Pro plan in Paddle)
#    - PADDLE_PLAN_ID_ENTERPRISE (create Enterprise plan in Paddle)
#    - CRON_SECRET (generate a secure random string)
#
# 3. OPTIONAL: Configure additional services:
#    - Storage (for file uploads)
#    - Email (for notifications)
#    - OAuth (for social login)
#    - Redis (for caching)
#
# 4. Run database migrations:
#    npx prisma generate
#    npx prisma db push
#
# 5. Start the development server:
#    npm run dev
#
# 6. Configure Paddle webhooks:
#    - Go to https://vendors.paddle.com/webhooks
#    - Add endpoint: https://yourdomain.com/api/webhooks/paddle
#    - Select events: subscription_created, subscription_updated, subscription_cancelled
#    - Copy webhook secret to PADDLE_WEBHOOK_SECRET
#
# =============================================================================

# =============================================================================
# POSTGREST DATA PLANE (Required — the REST/data API is served by PostgREST)
# =============================================================================
# Backenly serves every project's REST API through PostgREST, pointed at the
# same PostgreSQL as DATABASE_URL. Run PostgREST locally (default port 3002).
POSTGREST_URL=http://127.0.0.1:3002

# Signing secret PostgREST uses to verify the per-request JWTs the app mints.
# MUST match the app's signer. Generate a strong random string in production.
POSTGREST_JWT_SECRET=your-postgrest-jwt-secret-change-this-in-production

# How the autonomy loop restarts PostgREST when it is down or its schema cache
# is wedged. SET THIS IN PRODUCTION — without it the loop can detect and report
# a dead data plane but cannot repair it, and every project's /db/* endpoints
# stay down until a human notices.
#
# A wedged schema cache (PGRST002) does NOT clear on `NOTIFY pgrst, 'reload
# config'` — verified — so the process genuinely has to be restarted. The loop
# only runs this after an independent probe confirms the outage, at most once
# per 5-minute window, single-flighted across the whole platform, and it
# verifies the service answers again before recording a repair. See
# lib/postgrest/supervisor.ts.
#
# Deliberately not inferred: guessing the supervisor and being wrong means
# shelling an arbitrary string as root on a production host.
#   systemd:  POSTGREST_LOCAL_RESTART_COMMAND=systemctl restart postgrest
#   pm2:      POSTGREST_LOCAL_RESTART_COMMAND=pm2 restart postgrest
#   docker:   POSTGREST_LOCAL_RESTART_COMMAND=docker restart postgrest
#
# LOCAL, and optional. Restarting a process is a host concern. Under an
# orchestrator leave this EMPTY: a wedged task fails its health check and the
# orchestrator replaces it, which is the same repair without giving the
# application permission to manage infrastructure. Backenly holds no cloud
# credentials and must not gain any for this.
#
# `POSTGREST_RESTART_COMMAND` (no LOCAL) is still read for one transitional
# cycle so an older host does not lose its fallback, and warns when used.
POSTGREST_LOCAL_RESTART_COMMAND=

# =============================================================================
# AUTONOMY — the self-healing loop
# =============================================================================
# This is the feature the product is built around, and BOTH switches below
# default to OFF in code (lib/config/flags.ts reads every flag as false unless
# it is explicitly "true"). They were previously undocumented here, which meant
# a self-hosted install set up from this file ran with self-healing entirely
# dark while the dashboard still rendered the Autonomy section and the pricing
# page still promised healing every minute. Set both.
#
# The two are separate on purpose and the difference matters:
#
#   ENABLE_AUTONOMY_RECONCILER      the loop runs at all. With this on and live
#                                   execution OFF, the loop still evaluates every
#                                   project every minute and records what it WOULD
#                                   have done — but it repairs nothing. That is
#                                   shadow mode, and it is indistinguishable from
#                                   working autonomy on every dashboard surface.
#
#   ENABLE_AUTONOMY_LIVE_EXECUTION  the loop is allowed to actually apply fixes.
#                                   This is the one that makes self-healing real.
#                                   Leave it unset and you have a very thorough
#                                   monitoring product.
#
# Safety does not come from these flags — it comes from the layers underneath,
# all of which stay on regardless: only additive Tier-0/Tier-1 repairs are ever
# automatic (auth, destructive and irreversible changes always require a human),
# every schema fix is snapshotted before it runs and re-probed after, a fix that
# breaks a previously passing guarantee is rolled into review rather than
# recorded, changes freeze while a project is mid-incident, and a per-project
# circuit breaker bounds the whole thing. Each project owner can also dial their
# own level down to OFF at any time.
ENABLE_AUTONOMY_RECONCILER=true
ENABLE_AUTONOMY_LIVE_EXECUTION=true

# Per-project ceilings. All optional — the defaults are the intended product.
#
# Max repairs one tick may apply to one project. The loop runs every minute, so
# this bounds how fast a badly drifted backend converges. Default 10.
AUTONOMY_MAX_FIXES_PER_TICK=10
# Rolling window, in minutes, that the circuit breaker counts over. Default 60.
AUTONOMY_WINDOW_MIN=60
# Anti-storm ceiling: autonomous repairs per project per window before the
# breaker trips. This exists to catch a flapping detector, not to ration
# healing — a project needing this many repairs in an hour is broken, not busy.
# Default 500.
AUTONOMY_STORM_CEILING=500
# Hard per-window cap on autonomous repairs. LEAVE UNSET. It exists only as an
# incident escape hatch for pinning a single deployment; setting it caps healing
# on every plan, which is not how any tier is sold.
# AUTONOMY_MAX_ACTIONS_PER_WINDOW=

# Days an unverified, untrusted, entirely inactive signup is kept before
# /api/cron/reap-abandoned-signups deletes it. Accounts that own a project,
# hold an API key, made any request, or ever signed back in are never reaped.
ABANDONED_SIGNUP_GRACE_DAYS=14

# ── Outbound webhook egress ───────────────────────────────────────────────────
#
# Backenly POSTs to the URL an operator configures for a webhook. That request
# leaves the web process, which is not sandboxed, so the destination is a
# security boundary: without a control, a webhook pointed at
# http://127.0.0.1:3002 reaches the PostgREST data plane and one pointed at
# 169.254.169.254 reaches the cloud metadata service.
#
# Private, loopback and reserved addresses are therefore REFUSED by default,
# both when the URL is saved and again when the request is made (a hostname that
# resolves publicly today can resolve elsewhere tomorrow).
#
# Set this to true ONLY on a self-hosted deployment whose webhook receiver
# genuinely shares the host or the LAN — the service beside it in a compose
# file, for instance. It must never be set on Backenly Cloud, where the private
# ranges it unblocks are other tenants' traffic and the platform's own control
# plane.
#
# It does NOT unblock link-local (169.254.0.0/16, fe80::/10). No deployment has
# a legitimate reason to let a webhook read the instance credentials, and a
# self-hosted box on EC2 has an IMDS endpoint too.
#
# This is deliberately separate from BACKENLY_FUNCTION_EGRESS_ALLOW_PRIVATE,
# which governs where customer-authored function code may connect. Allowing your
# own webhook to reach your own service is not the same decision as allowing
# generated code to reach your LAN.
# BACKENLY_WEBHOOK_EGRESS_ALLOW_PRIVATE=false
