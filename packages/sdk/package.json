{
  "name": "@backenly/sdk",
  "version": "0.3.1",
  "description": "Official Backenly SDK — typed database, auth, storage, realtime and a supabase-js compatibility shim for any JavaScript or TypeScript project.",
  "license": "MIT",
  "author": "Backenly",
  "homepage": "https://backenly.com/resources",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/backenly/backenly.git",
    "directory": "packages/sdk"
  },
  "bugs": {
    "url": "https://github.com/backenly/backenly/issues"
  },
  "keywords": [
    "backenly",
    "backend",
    "baas",
    "postgres",
    "postgrest",
    "supabase-alternative",
    "auth",
    "realtime",
    "storage",
    "sdk",
    "typescript"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js",
      "default": "./dist/esm/index.js"
    },
    "./supabase": {
      "types": "./dist/esm/supabase-compat.d.ts",
      "import": "./dist/esm/supabase-compat.js",
      "require": "./dist/cjs/supabase-compat.js",
      "default": "./dist/esm/supabase-compat.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build:esm": "tsc -p tsconfig.esm.json",
    "build:cjs": "tsc -p tsconfig.cjs.json && node ../../scripts/sdk-cjs-package.mjs",
    "build": "npm run clean && npm run build:esm && npm run build:cjs",
    "dev": "tsc -p tsconfig.esm.json --watch",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {},
  "devDependencies": {
    "typescript": "^5.0.0"
  }
}
