# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies — catch nested node_modules in packages/ too, not just root
node_modules/
/.pnp
.pnp.js

# published package builds (regenerated by `tsc` in each package)
packages/*/dist/
packages/*/*.tsbuildinfo

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files — ignore ALL real env files; only *.example may be tracked.
# (.env.vercel had been committed with real production secrets — never again.)
.env
.env.*
!.env.example
!.env.storage.example

# vercel
.vercel
.env.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# prisma
/prisma/migrations

# logs
/logs
*.log

# IDE
.vscode
.idea
*.swp
*.swo
*~

# User-generated workspaces (IMPORTANT for production)
/workspace/
/tmp/

# Storage
/storage/

# Docker
docker-compose.override.yml

# Codex local tooling artifacts (screenshots, dev logs, config)
.codex/

# Pitch decks — private, never deploy to the web-served public/ folder
public/*.pdf

# Pre-cutover RLS snapshots (operational rollback artifacts, machine-specific)
.cutover-snapshots/

# Local operator secrets — never committed
.secrets.local.md

# Local Claude Code state — machine-specific, and has held credentials.
# Ignore the whole dir; only explicitly re-allow shared, secret-free config.
.claude/
!.claude/settings.json

# Playwright run artifacts. These were tracked, so every test run left the tree
# dirty with churn nobody reviews — and with parallel sessions running in this
# repo, a stray `git add .` sweeps them into an unrelated commit. Output, not source.
test-results/
playwright-report/

# Jest run logs. Same reasoning: a 222k-line captured console dump was tracked,
# and it carried a live database hostname into the repo. Output, not source.
test-run-*.txt

# Generated audit/test reports. Each of these is WRITTEN by a script at the repo
# root (feature-gap-audit, run-stress-test-500, run-qa-tests,
# test-comprehensive-runtime, …). They were tracked as if they were source, so
# the tree accumulated dozens of self-graded status reports that nobody reviewed
# and that leaked local paths and internal assessments. Rooted with a leading
# slash so only the generated copies match — .claude/skills/*/SKILL.md and the
# real docs/ tree are unaffected. Output, not source.
/COMPREHENSIVE_RUNTIME_RESULTS.md
/CONVERSATIONAL_INTELLIGENCE_REPORT.md
/FEATURE_GAP_REPORT.md
/LIVE_TEST_REPORT.md
/QA_LIVE_TEST_REPORT.md
/REAL_EXECUTION_RESULTS.md
/VERIFICATION_REPORT.md

# Eval and stress-test output. These were TRACKED, so the repo accumulated 72
# self-graded QA reports nobody reviewed — including one that published a
# working bypass of the destructive-operation safety filter, a production host
# address, and an "RLS policies: 0" line about a live multi-tenant database.
# The prompts are source; the scores are output.
evals/results/

# Pitch decks and generated slides — private, and public/*.pdf is web-served.
*.pptx

# Python build debris
__pycache__/
*.pyc

# Generated by scripts/build-sdk.mjs on every `npm run build`.
# Committing them meant every deploy dirtied the working tree, so the next
# `git pull` in scripts/deploy.sh would conflict and abort the deploy.
public/backenly-sdk.js
public/backenly-sdk.esm.js
public/backenly-supabase.esm.js

# selfops-bench receipts are produced per run and uploaded by CI as build
# artifacts. A hand-committed one goes stale the moment the corpus changes, and
# a stale receipt that contradicts the README is worse than no receipt.
bench/selfops/results/
