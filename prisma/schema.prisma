model WorkspaceFile {
  id          String     @id @default(uuid())
  projectId   String
  path        String
  content     String
  description String?
  language    String     @default("typescript")
  category    String     @default("code")
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  workspaceId String?
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([projectId, path])
  @@index([projectId])
  @@index([category])
  @@map("workspace_files")
}

model Table {
  id            String         @id @default(uuid())
  name          String
  schema        String         @default("public")
  description   String?
  projectId     String
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  apiDefinition ApiDefinition?
  project       Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([name, schema, projectId])
  @@map("tables")
}

model DatabaseIssue {
  id               String    @id @default(uuid())
  projectId        String
  title            String
  description      String
  severity         String
  database         String
  category         String
  impact           String?
  suggestedFix     String
  rawQuery         String?
  affectedTables   String[]
  estimatedImpact  String?
  detailedAnalysis String?
  whyItHappened    String?
  sqlFix           String?
  migrationSteps   String?
  status           String    @default("open")
  resolvedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  project          Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([severity])
  @@index([status])
  @@index([database])
  @@index([projectId, status])
  @@index([projectId, severity])
  @@map("database_issues")
}

model AuthProvider {
  id            String    @id @default(uuid())
  name          String    @unique
  enabled       Boolean   @default(false)
  configured    Boolean   @default(false)
  type          String
  clientId      String?
  clientSecret  String?
  redirectUri   String?
  scopes        String[]
  icon          String?
  warning       String?
  codeGenerated Boolean   @default(false)
  lastModified  DateTime?
  modifiedBy    String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("auth_providers")
}

model AuthPolicy {
  id            String   @id @default(uuid())
  name          String   @unique
  description   String
  enabled       Boolean  @default(false)
  warning       String?
  codeGenerated Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("auth_policies")
}

model WorkspaceOAuthConfig {
  id           String    @id @default(uuid())
  projectId    String
  provider     String
  clientId     String
  clientSecret String
  redirectUri  String?
  scopes       String[]  @default([])
  enabled      Boolean   @default(true)
  generatedAt  DateTime?
  configuredAt DateTime  @default(now())
  lastUsed     DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  project      Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, provider])
  @@index([projectId])
  @@index([provider])
  @@map("workspace_oauth_configs")
}

model ApiKey {
  id              String        @id @default(uuid())
  name            String
  keyPrefix       String
  role            String        @default("client")
  permissions     String[]
  userId          String
  lastUsed        DateTime?
  expiresAt       DateTime?
  rateLimit       Int           @default(1000)
  rateLimitWindow Int           @default(3600)
  requestCount    Int           @default(0)
  resetAt         DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  capabilities    String[]
  keyType         String        @default("public")
  projectId       String?
  serviceRole     Boolean       @default(false)
  keyHash         String        @unique
  key             String?
  // Scope decides which surfaces this key can call:
  //   "runtime" (default) — /api/v1/{projectId}/* runtime data API (SDK clients).
  //                         Cannot reach brain tools or any /api/mcp/* surface.
  //   "mcp"               — issued from the MCP setup page. Can call /api/mcp/*
  //                         (brain chat + direct tool dispatch + runtime data).
  //                         These can create/alter/drop tables — never embed
  //                         them in a public client.
  // A leaked SDK key cannot drop tables; a leaked MCP key can. Splitting the
  // scope keeps that blast radius explicit and auditable.
  scope           String        @default("runtime")
  // Free-text label for MCP keys, e.g. "Claude Code laptop" / "Cursor work mac".
  mcpClientLabel  String?
  usageLogs       ApiKeyUsage[]
  project         Project?      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([projectId])
  @@index([keyPrefix])
  @@index([keyType])
  @@index([resetAt])
  @@index([keyHash])
  @@index([scope])
  @@map("api_keys")
}

model ApiKeyUsage {
  id           String   @id @default(uuid())
  apiKeyId     String
  endpoint     String
  method       String
  statusCode   Int
  responseTime Int?
  timestamp    DateTime @default(now())
  metadata     Json?
  apiKey       ApiKey   @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)

  @@index([apiKeyId])
  @@index([timestamp])
  @@index([endpoint])
