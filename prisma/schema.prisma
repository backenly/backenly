  allowedExtensions String[]          @default([".jpg", ".jpeg", ".png", ".gif", ".webp", ".pdf", ".txt", ".csv"])
  allowedMimeTypes  String[]          @default(["image/jpeg", "image/png", "image/gif", "image/webp", "application/pdf", "text/plain", "text/csv"])
  blockExecutables  Boolean           @default(true)
