  reservedCount         Int      @default(0) // AI build actions reserved but not yet committed
  tokenCount            Int      @default(0)
  apiRequestCount       BigInt   @default(0) // API requests this month
  aiFunctionInvocations Int      @default(0) // AI Function invocations this month
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId])
