generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                      String                   @id @default(uuid())
  email                   String                   @unique
  name                    String?
  password                String?
  emailVerified           Boolean                  @default(false)
  twoFactorEnabled        Boolean                  @default(false)
  twoFactorSecret         String?
  provider                String                   @default("email")
  providerId              String?
  lastLogin               DateTime?
  lastActiveAt            DateTime?
  roleId                  String?
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  tokenVersion            Int                      @default(0)
  deletedAt               DateTime?
  suspendedAt             DateTime? // Set by admin to block all auth for this user
  suspensionReason        String?
  tier                    String                   @default("free")
  // Account lockout fields (#69)
  failedLoginAttempts     Int                      @default(0)
  lockedUntil             DateTime?
  // ── Assistant-credit bonus balance (referral / promo grants) ──────────────
  // Persistent, spendable balance of assistant credits granted outside the
  // monthly plan allowance. The effective monthly cap is
  // `plan.monthlyAiCredits + bonusCredits`; consumption is reconciled at month
  // rollover (see lib/billing/credit-ledger.ts). Never silently re-ratioed.
  bonusCredits            Int                      @default(0)
  // Last YYYY-MM whose bonus consumption has been reconciled into bonusCredits.
  // Guards the idempotent month-rollover reconciliation (no cron dependency).
  bonusReconciledThrough  String?
  // Referral attribution — who referred this user (set at signup from ?ref=).
  referredById            String?
  // ── Signup trust (anti-abuse) ────────────────────────────────────────────
  // How this account arrived. "trusted" is the normal path. "untrusted" is set
  // when the signup email landed in the challenge band (see lib/auth/email-trust.ts)
  // and must verify its mailbox before it can consume any resources. Existing
  // accounts default to trusted so this can never retroactively lock anyone out.
  trustLevel              String                   @default("trusted")
  // Score and reason codes recorded at signup, so a false positive can be
  // diagnosed later instead of guessed at.
  signupScore             Int?
  signupSignals           String[]                 @default([])
  signupIp                String?
  apiKeys                 ApiKey[]
  apiRequestLogs          ApiRequestLog[]
  auditLogs               AuditLog[]
  acknowledgedIncidents   Incident[]               @relation("IncidentAcknowledger")
  paddleSubscriptions     PaddleSubscription[]
  previewShares           PreviewShare[]
  projects                Project[]
  sessions                Session[]
  subscriptions           Subscription[]
  userAiUsage             UserAiUsage[]
  role                    Role?                    @relation(fields: [roleId], references: [id])
  workspaces              Workspace[]
  platformNotifications   PlatformNotification[]
  notificationPreferences NotificationPreference[]
  twoFactorBackupCodes    TwoFactorBackupCode[]
  supportTickets          SupportTicket[]
  featureRequests         FeatureRequest[]
  // ── Referral + credit-ledger relations ───────────────────────────────────
  referredBy              User?                    @relation("UserReferrals", fields: [referredById], references: [id], onDelete: SetNull)
  referrals               User[]                   @relation("UserReferrals")
  referralCode            ReferralCode?
  creditLedger            CreditLedgerEntry[]
  referralGrantsMade      ReferralGrant[]          @relation("ReferralReferrer")
  referralGrantReceived   ReferralGrant?           @relation("ReferralReferee")
  // ── Organization relations (Phase 6) ──────────────────────────────────────
  ownedOrganizations      Organization[]           @relation("OrgOwner")
  orgMemberships          OrganizationMember[]
  projectMemberships      ProjectMember[]

  @@index([email])
  @@index([provider, providerId])
  @@index([tokenVersion])
  @@index([deletedAt])
  @@index([suspendedAt])
  @@index([lockedUntil])
  @@index([lastActiveAt])
  @@index([referredById])
  @@map("users")
}

model Project {
  id                      String                 @id @default(uuid())
  name                    String
  description             String?
  userId                  String?
  createdAt               DateTime               @default(now())
  updatedAt               DateTime               @updatedAt
  environment             String                 @default("development")
  apiUrlDev               String?
  apiUrlStaging           String?
  apiUrlProd              String?
  apiRequests             Int                    @default(0)
  avgLatency              Int                    @default(0)
  errorCount              Int                    @default(0)
  storageUsed             BigInt                 @default(0)
  rowCount                Int                    @default(0)
  activeUsers             Int                    @default(0)
  lastMetricsUpdate       DateTime?
  lastObservedAt          DateTime? // Stamped at the end of every observer scan, clean or not — HealthFinding.detectedAt only moves when something is found, so it can't serve as a "last checked" clock
  maxFileSize             BigInt                 @default(10485760)
  maxFilesPerBucket       Int                    @default(1000)
  publicEnabled           Boolean                @default(false)
  slug                    String?                @unique
  storageLimit            BigInt                 @default(1073741824)
  customDomain            String?                @unique
  domainVerificationToken String?
  domainVerified          Boolean                @default(false)
  subdomain               String?                @unique
  workerContainerId       String?
  workerPort              Int?
  jwtSecret               String?
  anonKey                 String? // Public anon key (plaintext) — safe to embed in frontend code
  authManifest            Json?
  architecturalMemory     String?
  projectBrain            String? // JSON: ProjectBrainData — product vision, preferences, business rules
  deployedAt              DateTime?
  deploymentError         String?
  expiresAt               DateTime? // null = never expires (production). Set for sandbox projects.
  deletedAt               DateTime? // Soft delete — set instead of removing the row
  lockedDownAt            DateTime? // Founder-triggered emergency lockdown — blocks public API + freezes the project. See lib/platform/controls.ts.
  lockedDownReason        String? // Human-readable note for why the project was locked.
  isDeployed              Boolean                @default(false)
  isBackendGenerated      Boolean                @default(false)
  isFrontendConnected     Boolean                @default(false)
  hasExternalUsers        Boolean                @default(false)
  activeIntegrations      Json?
  projectStatus           ProjectStatus          @default(PRIVATE)
  // Autonomy risk dial — owner-controlled. AGGRESSIVE (Autopilot) by default:
  // self-healing IS the product (founder decision 2026-07-18) — the loop
  // auto-applies the safe Tier-0/1 band out of the box and the owner can dial
  // DOWN any time. The Tier-2+ approval floor (auth/destructive/irreversible)
  // is unaffected by this dial, and every read is still clamped to the plan
  // cap via getProjectAutonomyLevel. See lib/autonomy/autonomy-level.ts.
  autonomyLevel           AutonomyLevel          @default(AGGRESSIVE)
  publicUrl               String?
  activeGraphId           String?
  activeGraph             BackendGraph?          @relation("ActiveGraph", fields: [activeGraphId], references: [id])
  deployments             Deployment[]
  deploymentAudits        DeploymentAudit[]
  deployConfirmations     DeployConfirmation[]
  aiConfiguration         AiConfiguration?
  aiUsage                 AiUsage[]
  anomalies               Anomaly[]
  apiKeys                 ApiKey[]
  apiRequestLogs          ApiRequestLog[]
  auditLogs               AuditLog[]
  graphs                  BackendGraph[]         @relation("ProjectGraphs")
  blockedAttacks          BlockedAttack[]
  databaseIssues          DatabaseIssue[]
  delegatedConnections    DelegatedConnection[]
  incidents               Incident[]
  intentLogs              IntentLog[]
  schemaIntents           SchemaIntent[]
  logs                    Log[]
  metrics                 Metric[]
  previewShares           PreviewShare[]
  metadata                ProjectMetadata?
  user                    User?                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  providerCredentials     ProviderCredential[]
  roles                   Role[]
  securityIssues          SecurityIssue[]
  securityScans           SecurityScan[]
  storageBuckets          StorageBucket[]
  storageFiles            StorageFile[]
  multipartUploads        MultipartUpload[]
  tables                  Table[]
  workspaceOAuthConfigs   WorkspaceOAuthConfig[]
  workspaces              Workspace[]
  webhooks                Webhook[]
  customDomains           CustomDomain[]
  conversationMessages    ConversationMessage[]
  connectedApps           ConnectedApp[]
  envVars                 ProjectEnvVar[]

  integrationKeys        ProjectIntegrationKey[]
  appTriggers            AppTrigger[]
  permissionPolicies     PermissionPolicy[]
  aiFunctions            AiFunction[]
  projectUsage           ProjectUsage[]
  projectPreferences     ProjectPreference[]
  rejectionPatterns      ProjectRejectionPattern[]
  executionCancellations ExecutionCancellation[]
  executionTimeline      ExecutionTimelineEntry[]
  correctionEvents       CorrectionEvent[]
  workspaceBackups       WorkspaceBackup[]
  healthFindings         HealthFinding[]
  agentApprovalRequests  AgentApprovalRequest[]
  shareTokens            ShareToken[]
  workspaceBranches      WorkspaceBranch[]
  autonomousActions      AutonomousAction[]
  chatRuns               ChatRun[]
  backendEvents          BackendEvent[]
  changeReceipts         ChangeReceipt[]
  mauRecords             ProjectActiveUser[]
  authConfig             ProjectAuthConfig?
  // Owning organization (Phase 6). Nullable + backfilled lazily; when null the
  // access check falls back to owner-only, so this is fully additive.
  organizationId         String?
  organization           Organization?             @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  projectMembers         ProjectMember[]

  @@index([userId])
  @@index([updatedAt])
  @@index([expiresAt])
  @@index([deletedAt])
  @@index([organizationId])
  @@map("projects")
}

model ProjectIntegrationKey {
  id            String   @id @default(uuid())
  projectId     String
  integrationId String
  encryptedKey  String
  maskedKey     String
  connectedAt   DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Did the PROVIDER confirm this key works?
  //
  // "Stored" and "working" are different facts, and conflating them is how a
  // fabricated Stripe key read as `connected` until the first real customer
  // payment. verified | rejected | unverifiable | unreachable | unchecked —
  // see lib/integrations/key-verification.ts. `unverifiable` is honest, not a
  // failure: some credentials (webhook signing secrets, write-only ingest keys)
  // have no endpoint that can confirm them.
  verification       String   @default("unchecked")
  verificationDetail String?
  verifiedAt         DateTime?

  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, integrationId])
  @@index([projectId])
  @@map("project_integration_keys")
}

model DelegatedConnection {
  id          String               @id @default(uuid())
  projectId   String
  provider    String
  tokenHash   String               @unique
  permissions Json
  metadata    Json?
  expiresAt   DateTime
  createdAt   DateTime             @default(now())
  revokedAt   DateTime?
  lastUsedAt  DateTime?
  usageCount  Int                  @default(0)
  ipAddress   String?
  userAgent   String?
  project     Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  auditLogs   DelegationAuditLog[]

  @@index([projectId])
  @@index([tokenHash])
  @@index([provider])
  @@index([expiresAt])
  @@index([revokedAt])
  @@map("delegated_connections")
}

model DelegationAuditLog {
  id           String              @id @default(uuid())
  connectionId String
  action       String
  endpoint     String?
  ipAddress    String?
  userAgent    String?
  metadata     Json?
  createdAt    DateTime            @default(now())
  connection   DelegatedConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@index([connectionId])
  @@index([action])
  @@index([createdAt])
  @@map("delegation_audit_logs")
}

model ProjectMetadata {
  id                String   @id @default(uuid())
  projectId         String   @unique
  originalPrompt    String
  entities          Json
  relationships     Json
  behaviors         Json
  security          Json
  tablePlans        Json
  apiPlans          Json
  tablesCreated     Boolean  @default(false)
  apisCreated       Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  backendStateGraph Json?
  project           Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("project_metadata")
}

model IntentLog {
  id                  String    @id @default(uuid())
  projectId           String
  executionId         String
  intent              String
  canonicalIntent     Json
  timestamp           DateTime  @default(now())
  success             Boolean
  changes             Json?
  rollbackData        Json?
  rollbackExecutionId String?
  rolledBack          Boolean   @default(false)
  rolledBackAt        DateTime?
  liveMutation        Boolean   @default(false)
  liveMutationStatus  String?
  project             Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([timestamp])
  @@index([executionId])
  @@index([rolledBack])
  @@index([liveMutation])
  @@map("intent_logs")
}

/// Intent ledger — the shape a caller ASKED for, per column.
///
/// The platform records what it BUILT (the PostgreSQL catalog) but never
/// recorded what was REQUESTED. With nothing to compare against, a column
/// created as the wrong type is indistinguishable from a column that was
/// supposed to be that type, so no probe can flag it.
///
/// That gap is why `{ name: "start_date", type: "timestamp" }` sitting in the
/// database as INTEGER survived from May to July while the autonomy loop ran
/// continuously: the loop checks infrastructure invariants (missing RLS,
/// missing FKs, missing indexes) and had no notion of intent conformance. A
/// senior engineer notices "you asked for a date and got an integer" instantly.
///
/// Rows are written on the request path, BEFORE execution, so a mismatch is
/// always attributable — and deliberately never overwritten from the catalog,
/// which would make the ledger agree with reality by construction and destroy
/// its only purpose.
model SchemaIntent {
  id         String @id @default(uuid())
  projectId  String
  tableName  String
  columnName String

  /// Type as the caller declared it, e.g. "timestamp" — not the type created.
  requestedType     String
  requestedNullable Boolean?
  requestedUnique   Boolean?
  /// Table the caller asked this column to reference.
  requestedFkTo     String?

  /// Which surface declared it: create_table | add_column.
  source    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, tableName, columnName])
  @@index([projectId])
  @@index([projectId, tableName])
  @@map("schema_intents")
}

model BackendEvent {
  id          String         @id @default(uuid())
  projectId   String         @map("project_id")
  eventType   String         @map("event_type")
  actorType   String         @map("actor_type")
  actorId     String?        @map("actor_id")
  summary     String
  beforeState Json?          @map("before_state")
  afterState  Json?          @map("after_state")
  reason      String?
  riskLevel   String         @default("low") @map("risk_level")
  status      String         @default("applied")
  receiptId   String?        @map("receipt_id")
  createdAt   DateTime       @default(now()) @map("created_at")
  project     Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  receipt     ChangeReceipt? @relation(fields: [receiptId], references: [id], onDelete: SetNull)

  @@index([projectId, createdAt])
  @@index([projectId, eventType])
  @@index([projectId, status])
  @@index([eventType])
  @@index([riskLevel])
  @@index([receiptId])
  @@map("backend_events")
}

// Phase 6 — anonymized cross-project pattern learning. Deliberately has NO
// projectId/userId column: the aggregation itself (many projects collapsing
// into one counter row per project_type + pattern_type + resource_type) is
// the anonymization mechanism. Never write row data, free-text descriptions,
// or tenant identifiers here — only structural naming choices (table/column/
// API/auth-rule shapes) and outcome counts. See lib/patterns/cross-project-learning.ts.
model BackendPattern {
  id             String   @id @default(uuid())
  projectType    String   @map("project_type") // social-media | marketplace | saas | chat-app | blog | project-mgmt | general
  patternType    String   @map("pattern_type") // schema | auth | api | rollback | health_failure
  resourceType   String   @map("resource_type") // table | column | api_route | auth_rule | storage_bucket | rollback
  patternSummary String   @map("pattern_summary")
  frequency      Int      @default(0)
  failureCount   Int      @default(0)
  successCount   Int      @default(0)
  riskScore      String   @default("low") @map("risk_score")
  lastSeenAt     DateTime @default(now()) @map("last_seen_at")

  @@unique([projectType, patternType, resourceType])
  @@index([projectType])
  @@index([patternType])
  @@index([riskScore])
  @@map("backend_patterns")
}

model ChangeReceipt {
  id                String         @id @default(uuid())
  projectId         String         @map("project_id")
  eventIds          String[]       @default([]) @map("event_ids")
  title             String
  summary           String
  resourcesChanged  Json?          @map("resources_changed")
  riskLevel         String         @default("low") @map("risk_level")
  rollbackAvailable Boolean        @default(false) @map("rollback_available")
  rollbackId        String?        @map("rollback_id")
  createdAt         DateTime       @default(now()) @map("created_at")
  project           Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  events            BackendEvent[]

  @@index([projectId, createdAt])
  @@index([projectId, riskLevel])
  @@index([rollbackAvailable])
  @@map("change_receipts")
}

model BackendGraph {
  id             String         @id @default(uuid())
  projectId      String
  graphData      Json
  createdAt      DateTime       @default(now())
  intentId       String?
  sequenceNumber Int            @default(0)
  parentId       String? // For version lineage tracking
  project        Project        @relation("ProjectGraphs", fields: [projectId], references: [id], onDelete: Cascade)
  activeProjects Project[]      @relation("ActiveGraph")
  parent         BackendGraph?  @relation("VersionLineage", fields: [parentId], references: [id])
  children       BackendGraph[] @relation("VersionLineage")

  // CRITICAL: Unique version constraint - prevents duplicate sequence numbers
  @@unique([projectId, sequenceNumber])
  // CRITICAL: Version lineage constraint - ensures parent exists
  @@index([parentId])
  @@index([projectId])
  @@index([createdAt])
  @@index([intentId])
  @@map("backend_graphs")
}

model ProjectSuggestion {
  id              String   @id @default(uuid())
  projectId       String
  graphId         String
  type            String
  severity        String
  message         String
  rationale       String
  suggestedPrompt String?
  createdAt       DateTime @default(now())

  @@index([projectId])
  @@index([graphId])
  @@map("project_suggestions")
}

model Session {
  id                    String    @id @default(uuid())
  userId                String
  token                 String    @unique
  expiresAt             DateTime
  createdAt             DateTime  @default(now())
  projectId             String?
  // Refresh token fields (#67)
  refreshToken          String?   @unique
  refreshTokenExpiresAt DateTime?
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([projectId])
  @@index([expiresAt])
  @@index([refreshToken])
  @@map("sessions")
}

// 2FA backup codes (#71)
model TwoFactorBackupCode {
  id        String    @id @default(uuid())
  userId    String
  codeHash  String // bcrypt hash of the backup code
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("two_factor_backup_codes")
}

model Workspace {
  id                    String          @id @default(uuid())
  name                  String
  description           String?
  projectId             String
  userId                String?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
  environment           String          @default("development")
  apiBaseUrl            String?
  status                String          @default("active")
  totalFiles            Int             @default(0)
  totalRoutes           Int             @default(0)
  totalFunctions        Int             @default(0)
  lastActivity          DateTime?
  databaseProvisioned   Boolean         @default(false)
  databaseProvisionedAt DateTime?
  mongodbDatabase       String?
  postgresSchema        String?
  deployTarget          String          @default("node")
  language              String          @default("typescript")
  runtime               String          @default("express")
  runtimeLocked         Boolean         @default(true)
  files                 WorkspaceFile[]
  project               Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user                  User?           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId])
  @@index([userId])
  @@index([runtime])
  @@map("workspaces")
