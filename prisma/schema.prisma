// Monthly Active Users — one row per (project, end-user, calendar month).
// An end-user is "active" when they authenticate (sign-in / token refresh /
// OAuth) against a project in a given YYYY-MM. Distinct count per project per
// month is the billable MAU figure enforced against Plan.maxMonthlyActiveUsers.
model ProjectActiveUser {
  id         String   @id @default(uuid())
  projectId  String
  endUserId  String // id within workspace_{projectId}.users
  month      String // YYYY-MM
  lastSeenAt DateTime @default(now())
  createdAt  DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, endUserId, month])
  @@index([projectId, month])
  @@map("project_active_users")
}

// Credit reservation — holds a slot during long-running AI jobs.
// Status transitions: reserved → committed (on success) or refunded (on failure/timeout).
// Stale reservations (status=reserved past expiresAt) are cleaned up by the nightly cron.
model CreditReservation {
  id          String    @id @default(uuid())
  userId      String
  date        String // YYYY-MM — must match the UserAiUsage row it debits
  amount      Int       @default(1)
  jobId       String    @unique // opaque caller-supplied job identifier
  status      String    @default("reserved") // reserved | committed | refunded
  createdAt   DateTime  @default(now())
  expiresAt   DateTime // stale reservations auto-refunded after this time
  committedAt DateTime?
  refundedAt  DateTime?

  @@index([userId, date])
  @@index([jobId])
  @@index([status, expiresAt])
  @@map("credit_reservations")
}

// ─── Credit ledger (bonus assistant credits) ────────────────────────────────
// Append-only audit trail of every bonus-credit movement: grants (referral,
// promo, signup bonus) as positive amounts, and month-rollover burns (bonus
// consumed beyond the plan allowance) as negatives. The Billing "Credit
// activity" tab reads from here; `User.bonusCredits` is the running balance.
model CreditLedgerEntry {
  id           String   @id @default(uuid())
  userId       String
  // Signed credits: +grant, -burn. Sum over a user == bonusCredits ever moved.
  amount       Int
  // Running bonus balance immediately AFTER this entry (for a clean history UI).
  balanceAfter Int
  // 'referral_signup' | 'referral_paid' | 'promo' | 'admin_grant' |
  // 'monthly_bonus_burn' | 'signup_bonus'
  reason       String
  // Free-form human note shown in the history row.
  description  String?
  // Optional link to the originating record (ReferralGrant id, promo code, …).
  referenceId  String?
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("credit_ledger_entries")
}

// ─── Referral program ───────────────────────────────────────────────────────
// One stable, shareable code per user. `uses` is a denormalised counter of how
// many accounts signed up with this code (authoritative count lives in
// ReferralGrant rows).
model ReferralCode {
  id        String   @id @default(uuid())
  userId    String   @unique
  code      String   @unique
  uses      Int      @default(0)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([code])
  @@map("referral_codes")
}

// One row per referred signup. Tracks the two-stage reward: a signup grant to
// the referee, and a paid grant to the referrer when the referee first upgrades.
// refereeId is unique — a user can only be referred once.
model ReferralGrant {
  id                   String   @id @default(uuid())
  referrerId           String
  refereeId            String   @unique
  refereeEmail         String
  code                 String
  // 'signup_granted' (referee bonus paid) → 'paid_granted' (referrer bonus paid)
  status               String   @default("signup_granted")
  signupCreditsGranted Int      @default(0)
  payCreditsGranted    Int      @default(0)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  referrer User @relation("ReferralReferrer", fields: [referrerId], references: [id], onDelete: Cascade)
  referee  User @relation("ReferralReferee", fields: [refereeId], references: [id], onDelete: Cascade)

  @@index([referrerId])
  @@index([code])
  @@map("referral_grants")
}

// ─── Organizations (Phase 6 — team accounts) ────────────────────────────────
// A platform-level account that owns projects and (org-based) billing. Every
// user gets one personal Organization lazily (lib/org). Teams are formed by
// inviting other users as members with a role. Access + billing resolve through
// the org; the change is additive — a solo user's personal org behaves exactly
// like today's owner-only model.
model Organization {
  id        String   @id @default(uuid())
  name      String
  ownerId   String // the User who created it (also holds an OWNER membership row)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner          User                 @relation("OrgOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members        OrganizationMember[]
  invites        OrganizationInvite[]
  projectMembers ProjectMember[]
  projects       Project[]
  subscriptions  Subscription[]

  @@index([ownerId])
  @@map("organizations")
}

model OrganizationMember {
  id        String   @id @default(uuid())
  orgId     String
  userId    String
  // OWNER | ADMIN | DEVELOPER | VIEWER
  role      String   @default("DEVELOPER")
  // Project-scoped access (Pro+). When true, this member can only reach the
  // projects granted to them in ProjectMember — every other project in the org
  // is invisible and forbidden. OWNER/ADMIN ignore this flag (always org-wide).
  // When false (the default), the member has org-wide access — the original
  // Phase-6 behavior, so nothing changes for existing members. Enforcement runs
  // regardless of plan; only *setting* a restriction requires a paid plan, so a
  // downgrade can never silently widen a restricted member's reach.
  restricted Boolean  @default(false)
  createdAt DateTime @default(now())

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([orgId, userId])
  @@index([userId])
  @@map("organization_members")
}

// Project-scoped access grant (Pro+). One row = "this user may open this
// project" and only matters for members whose OrganizationMember.restricted is
// true. A restricted member with zero rows sees NOTHING (safe default — an
// empty allowlist never means "everything"). onDelete cascades keep the
// allowlist tight when a project, user, or org goes away.
model ProjectMember {
  id        String   @id @default(uuid())
  orgId     String
  userId    String
  projectId String
  createdAt DateTime @default(now())

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([userId, projectId])
  @@index([orgId, userId])
  @@index([projectId])
  @@map("project_members")
}

model OrganizationInvite {
  id          String    @id @default(uuid())
  orgId       String
  email       String
  role        String    @default("DEVELOPER")
  token       String    @unique
  invitedById String
  // Project-scoped invite (Pro+). If `restricted` is true, on accept the member
  // is created restricted and granted exactly `scopedProjectIds` — so they never
  // see the org's other projects, not even in the window right after joining.
  // Default false + empty = the original org-wide invite.
  restricted       Boolean  @default(false)
  scopedProjectIds String[] @default([])
  // pending | accepted | revoked | expired
  status      String    @default("pending")
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime  @default(now())

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, status])
  @@index([email])
  @@map("organization_invites")
}

